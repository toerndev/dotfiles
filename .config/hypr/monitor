#!/usr/bin/bash
mode=$1

# hl.monitor() merges into the existing rule for an output instead of
# replacing it, so `disabled = true` (from an earlier call)
# sticks until a rule sets `disabled = false` explicitly. Every rule that
# enables an output must therefore include it. Likewise `mirror` from the
# mirror modes sticks (and takes effect on the next hot-plug) unless cleared
# with `mirror = ""`.

if [[ "$1" == "ext" ]]; then
  # Use only the external monitor. Both rules sent in one eval call so
  # Hyprland validates the layout once at the end, avoiding a transient overlap
  # warning that would occur if they were applied sequentially.
  hyprctl eval 'hl.monitor({ output = "HDMI-A-1", disabled = false, mode = "preferred", position = "0x0", scale = 1, mirror = "" }) hl.monitor({ output = "eDP-1", disabled = true })'
  ~/.config/waybar/waybar.sh &

elif [[ "$1" == "laptop" ]]; then
  # Use only the built-in display (e.g. when HDMI is unplugged).
  hyprctl eval 'hl.monitor({ output = "eDP-1", disabled = false, mode = "preferred", position = "0x0", scale = 1 }) hl.monitor({ output = "HDMI-A-1", disabled = true })'
  ~/.config/waybar/waybar.sh &

elif [[ "$1" == "stack" ]]; then
  # Place HDMI-A-1 above eDP-1. Two separate calls are required because
  # `auto-down` (which positions eDP-1 below HDMI-A-1) only resolves correctly
  # after HDMI-A-1 has been fully initialized with its preferred resolution.
  # eDP-1 is disabled first so the initial call has no overlap at 0x0.
  hyprctl eval 'hl.monitor({ output = "eDP-1", disabled = true }) hl.monitor({ output = "HDMI-A-1", disabled = false, mode = "preferred", position = "0x0", scale = 1, mirror = "" })'
  # Query HDMI-A-1's logical height (physical pixels divided by scale factor)
  # and use it as the explicit Y offset for eDP-1, since `auto-down` is
  # unreliable when applied at runtime.
  hdmi_h=$(hyprctl monitors -j | jq -r '[.[] | select(.name=="HDMI-A-1")] | first | .height / .scale | floor')
  hyprctl eval "hl.monitor({ output = 'eDP-1', disabled = false, mode = 'preferred', position = '0x${hdmi_h}', scale = 1 })"
  ~/.config/waybar/waybar.sh &

elif [[ "$1" == "mirror" ]]; then
  # Mirror HDMI-A-1 onto eDP-1 at whatever resolution eDP-1 prefers.
  hyprctl eval 'hl.monitor({ output = "eDP-1", disabled = false, mode = "preferred", position = "0x0", scale = 1 }) hl.monitor({ output = "HDMI-A-1", disabled = false, mode = "preferred", position = "auto", scale = 1, mirror = "eDP-1" })'
  ~/.config/waybar/waybar.sh &

elif [[ "$1" == "mirror_fhd" ]]; then
  # Mirror at a fixed 1920x1080 on both outputs, useful when the external
  # display doesn't support the laptop's native resolution.
  hyprctl eval 'hl.monitor({ output = "eDP-1", disabled = false, mode = "1920x1080@120", position = "0x0", scale = 1 }) hl.monitor({ output = "HDMI-A-1", disabled = false, mode = "1920x1080", position = "0x0", scale = 1, mirror = "eDP-1" })'
  ~/.config/waybar/waybar.sh &
fi
